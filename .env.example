# Copy to .env. Compose reads it. Do not commit .env.
APP_PASSWORD=change-me

# Local dev (no Docker): npm run build:cli then set VDF_CLI to the published binary.
# Windows:
# VDF_CLI=./bin/vdf-cli/vdf-cli.exe
# Linux/macOS:
# VDF_CLI=./bin/vdf-cli/vdf-cli
# Or point VDF_CLI_DIR at a folder that contains vdf-cli (searched shallowly).

# Docker Compose: host folder mounted at /media in the container.
MEDIA_PATH=./media
# Local dev server: scan roots (comma-separated). Defaults to ./dev-media if unset.
# MEDIA_ROOTS=./dev-media
# Same host path as UPLOAD_LOCATION in the Immich .env (mounted at /data in Immich).
IMMICH_PATH=/data/upload
# Extra Immich bind mounts, container=host, separated by semicolons:
# IMMICH_BINDS=/data/library/admin=/storage/kevin/2_memories
# Fallback scan roots if the API key cannot read /api/libraries (optional):
# IMMICH_SCAN_ROOTS=/immich,/home/user/photos1

# CIDR of the reverse proxy that may set X-Forwarded-Proto. Leave empty on a plain LAN.
TRUSTED_PROXY_CIDR=
