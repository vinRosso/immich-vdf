# Copy to .env. Do not commit .env.

APP_PASSWORD=change-me
MEDIA_PATH=/external/library/path
IMMICH_PATH=/immich/data/library

# Optional. Account that owns MEDIA_PATH. Startup gives ./data to this id.
# PUID=1000
# PGID=100
# TRUSTED_PROXY_CIDR=172.16.0.0/12
# IMMICH_SCAN_ROOTS=/immich,/home/user/photos
# Thumbnail and playback encodes at once while no scan runs (default: three quarters of the cores, at most all
# of them). During a scan the section's Parallel setting applies.
# VDF_FFMPEG_SLOTS=3

# Local dev only (npm run dev). The Docker image sets these itself.
# VDF_CLI=./bin/vdf-cli/vdf-cli
# MEDIA_ROOTS=./dev-media
# IMMICH_LIBRARY=./dev-immich
# VOLUME_BINDS=/my/local/path:/data/library/admin,/my/other/path:/mnt/photos
# Scans decode inside vdf-cli (about 4x faster) when the FFmpeg 8 shared libraries can be loaded, and the first
# scan downloads them once when they cannot (about 90 MB). 0 always uses the ffmpeg program and never downloads;
# 1 forces native mode without checking. `npm run install-ffmpeg` downloads them ahead of time.
# VDF_NATIVE_FFMPEG=0
