# Copy to .env. Do not commit .env.

APP_PASSWORD=change-me
MEDIA_PATH=/external/library/path
IMMICH_PATH=/immich/data/library

# Optional. Account that owns MEDIA_PATH. Startup gives ./data to this id.
# PUID=1000
# PGID=100
# TRUSTED_PROXY_CIDR=172.16.0.0/12
# IMMICH_SCAN_ROOTS=/immich,/home/user/photos

# Local dev only (npm run dev). The Docker image sets these itself.
# VDF_CLI=./bin/vdf-cli/vdf-cli
# MEDIA_ROOTS=./dev-media
# IMMICH_LIBRARY=./dev-immich
