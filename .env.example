# Copy to .env. Compose reads it. Do not commit .env.
APP_PASSWORD=change-me

# Host folder for local media (original files).
MEDIA_PATH=./media
# Same host path as UPLOAD_LOCATION in the Immich .env (often /data/library)
IMMICH_PATH=/data/library
# Fallback scan roots if the API key cannot read /api/libraries (optional):
# IMMICH_SCAN_ROOTS=/immich,/home/user/photos1

# CIDR of the reverse proxy that may set X-Forwarded-Proto. Leave empty on a plain LAN.
TRUSTED_PROXY_CIDR=
